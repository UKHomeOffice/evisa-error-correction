{
  "name": "evisa-error-correction",
  "version": "2.0.0",
  "description": "eVisa error correction",
  "main": "index.js",
  "engines": {
    "node": ">=24.18.0 <25.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "start:dev": "[ -f .env ] && hof-build watch --env || hof-build watch",
    "build": "hof-build",
    "postinstall": "hof-build",
    "test:lint": "eslint . --config ./node_modules/eslint-config-hof/default.js",
    "test:unit": "jest --verbose --testPathPatterns=test/unit",
    "test:e2e:generate": "bddgen --config e2e-tests/playwright.config.ts",
    "test:e2e": "yarn test:e2e:generate && playwright test -c e2e-tests/playwright.config.ts",
    "test:e2e:one": "yarn test:e2e:generate && playwright test -c e2e-tests/playwright.config.ts --workers=1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UKHomeOffice/evisa-error-correction.git"
  },
  "author": "HOF",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/UKHomeOffice/evisa-error-correction/issues"
  },
  "homepage": "https://github.com/UKHomeOffice/evisa-error-correction#readme",
  "dependencies": {
    "accessible-autocomplete": "^3.0.1",
    "hof": "~23.0.4",
    "notifications-node-client": "^8.3.2"
  },
  "devDependencies": {
    "@cucumber/cucumber": "11.0.1",
    "@playwright/test": "1.49.1",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.0",
    "eslint-config-hof": "^1.3.4",
    "jest": "^30.4.1",
    "playwright": "1.49.1",
    "playwright-bdd": "8.2.0"
  },
  "resolutions": {
    "nodemailer": "^8.0.7"
  }
}
