{
  "name": "evisa-error-correction",
  "version": "2.0.0",
  "description": "eVisa error correction",
  "main": "index.js",
  "engines": {
    "node": ">=24.21.0 <25.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "start:dev": "[ -f .env ] && hof-build watch --env || hof-build watch",
    "build": "hof-build",
    "postinstall": "hof-build",
    "test:lint": "eslint . --config ./node_modules/eslint-config-hof/default.js",
    "test:unit": "jest --verbose --testPathPatterns=test/unit",
    "bddgen": "bddgen",
    "test:e2e": "bddgen && playwright test",
    "test:e2e:headed": "bddgen && playwright test --headed",
    "test:e2e:debug": "bddgen && playwright test --debug",
    "test:e2e:report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UKHomeOffice/evisa-error-correction.git"
  },
  "author": "HOF",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/UKHomeOffice/evisa-error-correction/issues"
  },
  "homepage": "https://github.com/UKHomeOffice/evisa-error-correction#readme",
  "dependencies": {
    "accessible-autocomplete": "^3.0.1",
    "hof": "~24.5.0",
    "notifications-node-client": "^8.4.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.0",
    "@playwright/test": "1.61.1",
    "@types/node": "^26.1.1",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-hof": "^1.3.4",
    "jest": "^30.4.2",
    "playwright": "1.61.1",
    "playwright-bdd": "^9.2.0"
  }
}
